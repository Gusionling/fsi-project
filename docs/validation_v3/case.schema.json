{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsi-project/v3/case",
  "title": "v3 case (JSONL 한 줄)",
  "type": "object",
  "required": ["case_id", "split", "label", "query", "topic", "chunks", "author_model", "generator", "created_at"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]+$" },
    "split": { "enum": ["dev", "calib", "test_sealed"] },
    "label": { "enum": ["attack", "normal", "integrity"] },
    "query": { "type": "string", "minLength": 2 },
    "topic": { "type": "string", "minLength": 1 },
    "chunks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["chunk_id", "text", "role"],
        "additionalProperties": false,
        "properties": {
          "chunk_id": { "type": "string" },
          "text": { "type": "string", "minLength": 10 },
          "role": { "enum": ["target", "context"] },
          "source_type": { "enum": ["official_notice", "faq", "internal_policy", "unknown"] }
        }
      }
    },
    "attack": {
      "type": "object",
      "required": ["tier", "intent", "has_entity", "expected_bad_behavior"],
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["T1", "T2", "T3", "T4"] },
        "intent": { "enum": ["acct_redirect", "external_link", "info_exfil", "prompt_leak", "false_confirmation"] },
        "has_entity": { "type": "boolean" },
        "attacker_entities": { "type": "array", "items": { "type": "string" } },
        "trigger_condition": { "type": ["string", "null"] },
        "expected_bad_behavior": { "type": "string", "minLength": 5 },
        "clean_twin_case_id": { "type": ["string", "null"] }
      },
      "if": { "properties": { "has_entity": { "const": true } }, "required": ["has_entity"] },
      "then": { "required": ["attacker_entities"], "properties": { "attacker_entities": { "minItems": 1 } } }
    },
    "normal": {
      "type": "object",
      "required": ["hard_negative_type", "gold_facts", "required_info"],
      "additionalProperties": false,
      "properties": {
        "hard_negative_type": {
          "enum": ["none", "policy_change", "overdue_notice", "auth_notice", "fee_waiver", "incident_report", "password_reset", "contact_info"]
        },
        "gold_facts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_info": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["field", "poisoned_value", "true_value"],
      "additionalProperties": false,
      "properties": {
        "field": { "enum": ["fee", "deadline", "limit"] },
        "poisoned_value": { "type": "string" },
        "true_value": { "type": "string" }
      }
    },
    "trusted_fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application_status": {
          "type": "object",
          "additionalProperties": {
            "enum": ["not_received", "received_pending_review", "approved", "rejected", "completed"]
          }
        },
        "procedure_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "author_model": { "type": "string", "minLength": 1 },
    "generator": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "notes": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "label": { "const": "attack" } }, "required": ["label"] }, "then": { "required": ["attack"] } },
    { "if": { "properties": { "label": { "const": "normal" } }, "required": ["label"] }, "then": { "required": ["normal"] } },
    { "if": { "properties": { "label": { "const": "integrity" } }, "required": ["label"] }, "then": { "required": ["integrity"] } }
  ]
}
