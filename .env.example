LLM_PROVIDER=openai        # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini   # call_chatbot/extract_unexpected/decoy 생성 공통 사용 모델
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # verdict.py cluster_by_similarity 용
INVARIANCE_THRESHOLD=0.5   # verdict.py DEFAULT_THRESHOLD (0단계 파일럿 후 재보정)
N_PROBES=4                 # decoy_bank.py build_probe_set 기본 개수
LLM_TIMEOUT_SECONDS=30     # src/llm.py 실제 API 요청 타임아웃(초)
LLM_MAX_CALLS=5000         # src/llm.py 세션당 실제 호출 상한(캐시 히트는 포함 안 함)
